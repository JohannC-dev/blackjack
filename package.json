{
  "name": "minuit-blackjack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun server/index.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 15000 tests/game-wallet.test.ts tests/economy.test.ts tests/engine.test.ts tests/poker.test.ts tests/tower.test.ts tests/chicken.test.ts tests/mines.test.ts tests/roulette.test.ts",
    "test:multiplayer": "bun tests/multiplayer.ts",
    "test:roulette-multiplayer": "bun tests/roulette-multiplayer.ts",
    "test:poker-multiplayer": "bun tests/poker-multiplayer.ts",
    "test:spin-multiplayer": "bun tests/spin-multiplayer.ts",
    "test:tower-multiplayer": "bun tests/tower-multiplayer.ts",
    "test:friends": "bun tests/friends.ts",
    "test:ui": "bun tests/ui-layout.ts",
    "test:poker-ui": "bun tests/poker-ui.ts",
    "test:poker-lobby": "bun tests/poker-lobby.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.9"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@effect/sql": "0.52.0",
    "@effect/sql-drizzle": "0.51.0",
    "@effect/sql-pg": "0.53.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@marsidev/react-turnstile": "^1.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "effect": "^3.22.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "pg": "8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3"
  }
}
